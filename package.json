{
  "name": "@wess2001/nexus",
  "version": "0.1.0-dev.1",
  "description": "One engineering gate for code quality, performance, and application security.",
  "type": "module",
  "bin": {
    "nexus": "./bin/nexus.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "docs",
    "nexus.config.example.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check:self": "node ./bin/nexus.js doctor --json",
    "prepublishOnly": "npm run check",
    "check": "npm test && node ./bin/nexus.js doctor --json",
    "pack:check": "npm pack --dry-run",
    "test:integration": "node scripts/integration-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@wess2001/component-vault": ">=0.6.0 <1",
    "@wess2001/velocity": ">=0.3.1 <1",
    "@wess2001/specter": ">=0.1.0 <1"
  },
  "peerDependenciesMeta": {
    "@wess2001/component-vault": {
      "optional": true
    },
    "@wess2001/velocity": {
      "optional": true
    },
    "@wess2001/specter": {
      "optional": true
    }
  },
  "keywords": [
    "developer-tools",
    "appsec",
    "performance",
    "code-quality",
    "ci",
    "sarif"
  ],
  "license": "MIT",
  "author": "WessYu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WessYu/NEXUS.git"
  },
  "homepage": "https://github.com/WessYu/NEXUS#readme",
  "bugs": {
    "url": "https://github.com/WessYu/NEXUS/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
